rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string ? request.auth.token.role : '';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isTeacher() {
      return role() == 'teacher' || isAdmin();
    }

    function isStudent() {
      return role() == 'student';
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function writesSchoolScopedDoc() {
      return signedIn()
        && (!('schoolId' in request.resource.data) || request.auth.token.schoolId == request.resource.data.schoolId);
    }

    function readsSchoolScopedDoc() {
      return signedIn()
        && (!('schoolId' in resource.data) || isAdmin() || request.auth.token.schoolId == resource.data.schoolId);
    }

    match /users/{userId} {
      allow read: if ownsUser(userId) || isTeacher();
      allow create, update: if ownsUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /courses/{courseId} {
      allow read: if readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /lessons/{lessonId} {
      allow read: if readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /generatedLessons/{lessonId} {
      allow read: if readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /cinematicLessons/{lessonId} {
      allow read: if readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /cinematicAssets/{assetId} {
      allow read: if readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /cinematicAssignments/{assignmentId} {
      allow read: if readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /assignments/{assignmentId} {
      allow read: if readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /studentResponses/{responseId} {
      allow read: if isTeacher() || (isStudent() && request.auth.uid == resource.data.studentId);
      allow create: if signedIn()
        && writesSchoolScopedDoc()
        && (isTeacher() || request.auth.uid == request.resource.data.studentId);
      allow update: if signedIn()
        && writesSchoolScopedDoc()
        && (isTeacher() || request.auth.uid == resource.data.studentId);
      allow delete: if isTeacher();
    }

    match /lessonProgress/{progressId} {
      allow read: if isTeacher() || (isStudent() && request.auth.uid == resource.data.studentId);
      allow create, update: if signedIn()
        && writesSchoolScopedDoc()
        && (isTeacher() || request.auth.uid == request.resource.data.studentId);
      allow delete: if isTeacher();
    }

    match /platformConnections/{id} {
      allow read: if isTeacher() && readsSchoolScopedDoc();
      allow create, update, delete: if isAdmin() && writesSchoolScopedDoc();
    }

    match /platformCredentials/{id} {
      allow read, write: if isAdmin() && writesSchoolScopedDoc();
    }

    match /externalImports/{id} {
      allow read: if isTeacher() && readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /platformStudentMappings/{id} {
      allow read: if isTeacher() && readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /learningEvents/{id} {
      allow read: if isTeacher() && readsSchoolScopedDoc();
      allow create: if signedIn()
        && writesSchoolScopedDoc()
        && (isTeacher() || request.auth.uid == request.resource.data.studentId);
      allow update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /studentMasteryProfiles/{id} {
      allow read: if isTeacher() && readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /classMasteryProfiles/{id} {
      allow read: if isTeacher() && readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /aiRecommendations/{id} {
      allow read: if isTeacher() && readsSchoolScopedDoc();
      allow create, update, delete: if isTeacher() && writesSchoolScopedDoc();
    }

    match /integrationAuditLogs/{id} {
      allow read: if isAdmin() && readsSchoolScopedDoc();
      allow create: if isTeacher() && writesSchoolScopedDoc();
      allow update, delete: if false;
    }

    match /syncSchedules/{id} {
      allow read: if isTeacher() && readsSchoolScopedDoc();
      allow create, update, delete: if isAdmin() && writesSchoolScopedDoc();
    }

    match /syncJobs/{id} {
      allow read: if isTeacher() && readsSchoolScopedDoc();
      allow create, update: if isTeacher() && writesSchoolScopedDoc();
      allow delete: if isAdmin();
    }

    match /driveIngestionConfigs/{id} {
      allow read, write: if isAdmin() && writesSchoolScopedDoc();
    }

    match /connectorAuditLogs/{id} {
      allow read: if isAdmin() && readsSchoolScopedDoc();
      allow create: if isTeacher() && writesSchoolScopedDoc();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
