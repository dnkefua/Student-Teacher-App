rules_version = '2';

// EIS Maths Studio · DEMO STORAGE RULES
// Intentionally OPEN for the EIS evaluation period — uploads use the
// demo-user pattern (no Firebase Auth yet). Before any non-demo
// production traffic, scope writes to authenticated teachers and
// require request.auth.uid to match the path prefix.

service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{userId}/{allPaths=**} {
      allow read, write: if true;
    }
  }
}
